MODE=github-releases
# For chart-releaser, use MODE=chart-releaser and optionally set its branch:
# CHART_RELEASER_PAGES_BRANCH=gh-pages
# For local-only, use MODE=local-only, remove the GitHub values, and set LOCAL_PATH.
GITHUB_OWNER=acme
GITHUB_REPO=charts
GITHUB_TOKEN=
# Optional in either GitHub mode; use an absolute path inside the container.
LOCAL_PATH=
PORT=8080
CACHE_TTL_SECONDS=60
LOG_LEVEL=INFO
